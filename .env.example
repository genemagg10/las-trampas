# Copy to .env.local for development. Never commit real values.
# The app starts without these. Missing keys turn features off and show a banner.

# ---- Site ----
# Public URL, no trailing slash. Use http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase ----
# Project Settings → API. Use the new publishable key, or the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Legacy name, used only if the publishable key is unset:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only. New secret key, or the legacy service_role key. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Stripe (test mode until launch) ----
# Developers → API keys. Use sk_test_ / pk_test_ until the treasurer switches to live.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Developers → Webhooks → signing secret for the endpoint /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Resend ----
RESEND_API_KEY=re_xxx
# A verified sender, for example "Las Trampas Pool <updates@lastrampaspool.com>"
EMAIL_FROM="Las Trampas Pool <updates@lastrampaspool.com>"

# ---- Vercel Cron ----
# Vercel sends this as Authorization: Bearer <CRON_SECRET> on cron requests.
CRON_SECRET=generate-a-long-random-string

# ---- Demo data (never in production) ----
# SEED_DEMO=yes npm run seed:demo
# SEED_DEMO=yes
